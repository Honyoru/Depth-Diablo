// Recommended extensions for the 2D game (GDD 3.1.1 and the Q87-Q132 conventions).
// VS Code offers to install them when a teammate opens the folder.
{
  "recommendations": [
    // Java 21 + Gradle (libGDX project generated by gdx-liftoff)
    "vscjava.vscode-java-pack",
    "vscjava.vscode-gradle",

    // Code style: Google Java Style, 100 columns (Q87, Q92). CI runs Spotless with the same formatter.
    "josevseb.google-java-format-for-vs-code",
    "editorconfig.editorconfig",

    // Bug and smell hints while typing (CI runs SpotBugs + PMD, Q125)
    "sonarsource.sonarlint-vscode",
    "usernamehw.errorlens",

    // Git: Conventional Commits (Q123), history, GitHub Actions CI (Q124)
    "vivaxy.vscode-conventional-commits",
    "eamodio.gitlens",
    "github.vscode-github-actions",

    // UML: draw.io first, PlantUML once the build exists (Q108)
    "hediet.vscode-drawio",
    "jebbs.plantuml",

    // Tiled maps (.tmx / .tsx are XML) and data files
    "redhat.vscode-xml",

    // Working together live (pair debugging, reviews)
    "ms-vsliveshare.vsliveshare",

    // English code and docs (Q91), French game text (5.3)
    "streetsidesoftware.code-spell-checker",
    "streetsidesoftware.code-spell-checker-french"
  ]
}
