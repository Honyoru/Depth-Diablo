lor=#666666;fontFamily=Courier New;fontSize=11;dashed=1;" vertex="1" parent="1"><mxGeometry x="376" y="116" width="124" height="30" as="geometry"/></mxCell><mxCell id="c11" value="Renderer" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#eeeeee;strokeColor=#999999;fontColor=#666666;fontFamily=Courier New;fontSize=11;dashed=1;" vertex="1" parent="1"><mxGeometry x="672" y="116" width="88" height="30" as="geometry"/></mxCell><mxCell id="c2" value="&lt;div style='line-height:15px'&gt;&lt;div style='text-align:center'&gt;«enum»&lt;br&gt;&lt;b&gt;ViewMode&lt;/b&gt;&lt;/div&gt;&lt;div style='border-top:1px solid #333333;margin:3px -6px'&gt;&lt;/div&gt;SPRITES&lt;br&gt;XRAY&lt;br&gt;HIGH_CONTRAST&lt;div style='border-top:1px solid #333333;margin:3px -6px'&gt;&lt;/div&gt;+ next(): ViewMode&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fontFamily=Courier New;fontSize=11;fillColor=#ffffff;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="918" y="116" width="160" height="116" as="geometry"/></mxCell><mxCell id="c4" value="&lt;div style='line-height:15px'&gt;&lt;div style='text-align:center'&gt;«record»&lt;br&gt;&lt;b&gt;EventLaser.Line&lt;/b&gt;&lt;/div&gt;&lt;div style='border-top:1px solid #333333;margin:3px -6px'&gt;&lt;/div&gt;- event: GameEvent&lt;br&gt;- fromX: float&lt;br&gt;- fromY: float&lt;br&gt;- toX: float&lt;br&gt;- toY: float&lt;br&gt;- ticksLeft: int&lt;div style='border-top:1px solid #333333;margin:3px -6px'&gt;&lt;/div&gt;+ hasReceiver(): boolean&lt;br&gt;- withTicksLeft(int): EventLaser.Line&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fontFamily=Courier New;fontSize=11;fillColor=#ffffff;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="1175" y="116" width="296" height="176" as="geometry"/></mxCell><mxCell id="c9" value="&lt;div style='line-height:15px'&gt;&lt;div style='text-align:center'&gt;&lt;b&gt;EventLaserOve