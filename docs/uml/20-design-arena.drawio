<mxfile host="app.diagrams.net" agent="tools/uml/generate_uml.py"><diagram id="20-design-arena" name="Design, Arena: the 6 Nov draft completed with the code"><mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="Design, Arena: the 6 Nov draft completed with the code" style="text;html=1;fontSize=18;fontStyle=1;align=left;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="1400" height="30" as="geometry"/></mxCell><mxCell id="legend" value="Generated by tools/uml/generate_uml.py from the first draft (docs/uml/drafts) and the compiled classes. White: in the code, drawn from it. Yellow «planned»: still a design, as the draft wrote it. Hollow arrow: extends (dashed: implements); blue open arrow: a field of that type or a link from the draft." style="text;html=1;fontSize=11;fontColor=#666666;align=left;" vertex="1" parent="1"><mxGeometry x="40" y="42" width="1600" height="20" as="geometry"/></mxCell><mxCell id="c0" value="&lt;div style='line-height:15px'&gt;&lt;div style='text-align:center'&gt;&lt;b&gt;ArenaCycle&lt;/b&gt;&lt;/div&gt;&lt;div style='border-top:1px solid #333333;margin:3px -6px'&gt;&lt;/div&gt;- wavesPerCycle: int&lt;br&gt;- breakTicks: int&lt;br&gt;- wave: int&lt;br&gt;- phase: ArenaCycle.Phase&lt;br&gt;- breakTicksLeft: int&lt;br&gt;- score: int&lt;br&gt;- shopEnabled: boolean&lt;div style='border-top:1px solid #333333;margin:3px -6px'&gt;&lt;/div&gt;+ ArenaCycle(int, int)&lt;br&gt;+ ArenaCycle(int, int, boolean)&lt;br&gt;+ getWaveNumber(): int&lt;br&gt;+ getPhase(): ArenaCycle.Phase&lt;br&gt;+ getBreakTicksLeft(): int&lt;br&gt;+ getScore(): int&lt;br&gt;+ update(): void&lt;br&gt;+ waveCleared(): void&lt;br&gt;+ startNextCycle(): boolean&lt;br&gt;+ isBossWave(): boolean&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;