0px&quot;&gt;engine · owns the bus, one per run&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;dashed=1;dashPattern=6 4;" vertex="1" parent="1"><mxGeometry x="40" y="120" width="250" height="44" as="geometry"/></mxCell><mxCell id="Character" value="&lt;b&gt;Character&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;entity · page Entities&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;dashed=1;dashPattern=6 4;" vertex="1" parent="1"><mxGeometry x="40" y="250" width="250" height="44" as="geometry"/></mxCell><mxCell id="e298" value="listeners" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;startArrow=diamondThin;startFill=0;startSize=16;endArrow=open;endSize=10;exitX=1;exitY=0.2727;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="EventBus" target="EventListener"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="el299" value="0..*" style="edgeLabel;resizable=0;html=1;align=center;verticalAlign=middle;fontSize=11;" connectable="0" vertex="1" parent="e298"><mxGeometry x="0.85" relative="1" as="geometry"><mxPoint x="0" y="-10" as="offset"/></mxGeometry></mxCell><mxCell id="e300" value="queue" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;startArrow=diamondThin;startFill=1;startSize=16;endArrow=open;endSize=10;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="EventBus" target="GameEvent"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="el301" value="0..*" style="edgeLabel;resizable=0;html=1;align=center;verticalAlign=middle;fontSize=11;" connectable="0" vertex="1" parent="e300"><mxGeometry x="0.85" relative="1" as="geometry"><mxPoint x="0" y="-10" as="offset"/></mxGeometry></mxCell><mxCell id="e302" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endSize=14;endFill=0;dashed=1;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="DamageDealt" target="GameEvent"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e303" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endSize=14;endFill=0;dashed=1;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="EntityDied" target="GameEvent"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e304" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endSize=14;endFill=0;dashed=1;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="ItemPickedUp" target="GameEvent"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e305" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endSize=14;endFill=0;dashed=1;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="RoomCleared" target="GameEvent"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e306" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endSize=14;endFill=0;dashed=1;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="TriggerBoxRef" target="EventListener"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e307" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endSize=14;endFill=0;dashed=1;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="EventLaser" target="EventListener"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e308" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;startArrow=diamondThin;startFill=1;startSize=16;endArrow=open;endSize=10;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.1591;entryDx=0;entryDy=0;" edge="1" parent="1" source="World" target="EventBus"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="el309" value="1" style="edgeLabel;resizable=0;html=1;align=center;verticalAlign=middle;fontSize=11;" connectable="0" vertex="1" parent="e308"><mxGeometry x="0.85" relative="1" as="geometry"><mxPoint x="0" y="-10" as="offset"/></mxGeometry></mxCell><mxCell id="e310" value="«publishes»" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=open;endSize=10;dashed=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.6515;entryDx=0;entryDy=0;" edge="1" parent="1" source="Character" target="EventBus"><mxGeometry relative="1" as="geometry"><mxPoint x="0" y="-12" as="offset"/></mxGeometry></mxCell><mxCell id="n_flow" value="Pattern: Observer (Q104: the roles are interfaces first). No singleton: World creates&lt;br&gt;the bus and passes it to every emitter and listener (Q103).&lt;br&gt;publish() only queues. World calls flush() once per tick, after every update(): each&lt;br&gt;queued event reaches the listeners of its type, then the subscribeAll() listeners.&lt;br&gt;An event published during flush() waits for the next tick, so a handler cannot loop.&lt;br&gt;Rewind (R) calls clear(): queued events from an undone tick are dropped." style="shape=note;size=14;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=10;spacingTop=4;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1570" y="100" width="560" height="96" as="geometry"/></mxCell><mxCell id="n_events" value="GameEvent is sealed and every event is a record (Q97), so a switch over events is&lt;br&gt;checked by the compiler. source() is the emitter: F2 draws a line from it to each&lt;br&gt;listener that is an entity (GDD 1.1.2). The emitter never holds the receiver.&lt;br&gt;Emitters: Character (DamageDealt, EntityDied), Player (ItemPickedUp), room logic&lt;br&gt;(RoomCleared, the last enemy of a sealed room). The room's TriggerBox calls action.undo() on RoomCleared,&lt;br&gt;so SealDoors reopens the doors (Q13).&lt;br&gt;The event list is still open (Q24): these four are the first ones." style="shape=note;size=14;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=10;spacingTop=4;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1570" y="230" width="560" height="112" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
