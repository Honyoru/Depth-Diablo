lative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e256" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;startArrow=diamondThin;startFill=1;startSize=16;endArrow=open;endSize=10;exitX=0.92;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="Projectile" target="Hitbox"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1897.16" y="925"/><mxPoint x="2278.5" y="925"/></Array></mxGeometry></mxCell><mxCell id="el257" value="1" style="edgeLabel;resizable=0;html=1;align=center;verticalAlign=middle;fontSize=11;" connectable="0" vertex="1" parent="e256"><mxGeometry x="0.85" relative="1" as="geometry"><mxPoint x="0" y="-10" as="offset"/></mxGeometry></mxCell><mxCell id="e258" value="statuses" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;startArrow=diamondThin;startFill=1;startSize=16;endArrow=open;endSize=10;exitX=0;exitY=0.06;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="Character" target="StatusEffect"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="960" y="743.64"/><mxPoint x="960" y="365.0"/></Array></mxGeometry></mxCell><mxCell id="el259" value="0..*" style="edgeLabel;resizable=0;html=1;align=center;verticalAlign=middle;fontSize=11;" connectable="0" vertex="1" parent="e258"><mxGeometry x="0.9" relative="1" as="geometry"><mxPoint x="0" y="-10" as="offset"/></mxGeometry></mxCell><mxCell id="e260" value="build" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=open;endSize=10;exitX=0;exitY=0.5127;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="Character" target="CharacterBuild"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="el261" value="1" style="edgeLabel;resizable=0;html=1;align=center;verticalAlign=middle;fontSize=11;" connectable="0" vertex="1" parent="e260"><mxGeometry x="0.85" relative="1" as="geometry"><mxPoint x="0" y="-10" as="offset"/></mxGeometry></mxCell><mxCell id="e262" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;startArrow=diamondThin;startFill=1;startSize=16;endArrow=open;endSize=10;exitX=1;exitY=0.0857;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="Player" target="Inventory"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="el263" value="1" style="edgeLabel;resizable=0;html=1;align=center;verticalAlign=middle;fontSize=11;" connectable="0" vertex="1" parent="e262"><mxGeometry x="0.85" relative="1" as="geometry"><mxPoint x="0" y="-10" as="offset"/></mxGeometry></mxCell><mxCell id="e264" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=open;endSize=10;exitX=1;exitY=0.249;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="Player" target="PlayerInput"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="el265" value="1" style="edgeLabel;resizable=0;html=1;align=center;verticalAlign=middle;fontSize=11;" connectable="0" vertex="1" parent="e264"><mxGeometry x="0.85" relative="1" as="geometry"><mxPoint x="0" y="-10" as="offset"/></mxGeometry></mxCell><mxCell id="e266" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=open;endSize=10;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="ItemPickup" target="Item"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="el267" value="1" style="edgeLabel;resizable=0;html=1;align=center;verticalAlign=middle;fontSize=11;" connectable="0" vertex="1" parent="e266"><mxGeometry x="0.85" relative="1" as="geometry"><mxPoint x="0" y="-10" as="offset"/></mxGeometry></mxCell><mxCell id="e268" value="«uses»" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=open;endSize=10;dashed=1;exitX=0;exitY=0.24;exitDx=0;exitDy=0;entryX=1;entryY=0.2586;entryDx=0;entryDy=0;" edge="1" parent="1" source="Enemy" target="EnemyState"><mxGeometry relative="1" as="geometry"><mxPoint x="0" y="-12" as="offset"/></mxGeometry></mxCell><mxCell id="e269" value="«creates»" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=open;endSize=10;dashed=1;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.212;entryDx=0;entryDy=0;" edge="1" parent="1" source="EnemyFactory" target="Enemy"><mxGeometry relative="1" as="geometry"><mxPoint x="0" y="-12" as="offset"/></mxGeometry></mxCell><mxCell id="e270" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=open;endSize=10;exitX=0.85;exitY=0;exitDx=0;exitDy=0;entryX=0.4792;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="SummonerEnemy" target="EnemyFactory"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e271" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;startArrow=diamondThin;startFill=1;startSize=16;endArrow=open;endSize=10;exitX=1;exitY=0.2597;exitDx=0;exitDy=0;entryX=0;entryY=0.3571;entryDx=0;entryDy=0;" edge="1" parent="1" source="Boss" target="BossPhase"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="el272" value="1..*" style="edgeLabel;resizable=0;html=1;align=center;verticalAlign=middle;fontSize=11;" connectable="0" vertex="1" parent="e271"><mxGeometry x="0.85" relative="1" as="geometry"><mxPoint x="0" y="-10" as="offset"/></mxGeometry></mxCell><mxCell id="n_entity" value="update() is final (Template Method): it calls onUpdate(), the hook each&lt;br&gt;subclass fills. Character.onUpdate(): statuses and i-frames -&amp;gt; think() -&amp;gt; move.&lt;br&gt;Player.think() reads PlayerInput; Enemy.think() runs its gdx-ai state machine.&lt;br&gt;Rewind (R, Memento): every tick each entity writes its own state into a&lt;br&gt;primitive-array StateBuffer (ring buffer, 5 s x 60 ticks, Q86)." style="shape=note;size=14;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=10;spacingTop=4;fontSize=11;" vertex="1" parent="1"><mxGeometry x="2080" y="100" width="470" height="100" as="geometry"/></mxCell><mxCell id="e273" value="" style="endArrow=none;dashed=1;html=1;rounded=0;" edge="1" parent="1" source="n_entity" target="Entity"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n_world" value="Pickable (team): ItemPickup needs the pickup key (2.4); coins and keys go to counters&lt;br&gt;on the Player when touched (proposal). Interactable (proposal): what the interact key&lt;br&gt;opens: chest, door, shop. Door: KEY_LOCKED opens with a key (Q80); SEALED = arena room&lt;br&gt;locked until every enemy inside is dead (Q13). Wall (team): static, blocks movement;&lt;br&gt;proposal: walls can stay tiles of the floor's collision layer, unless the editor (TAB)&lt;br&gt;must move them. The Shopkeeper is never Damageable (1.3.1)." style="shape=note;size=14;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=10;spacingTop=4;fontSize=11;" vertex="1" parent="1"><mxGeometry x="2590" y="100" width="560" height="112" as="geometry"/></mxCell><mxCell id="n_hit" value="Combat (1.5): a Hitbox hits a Damageable hurtbox it overlaps, never its owner.&lt;br&gt;One Hitbox can hit several targets, each one only once during its lifetime;&lt;br&gt;a new attack creates a new Hitbox, so it can hit the same target again.&lt;br&gt;Lifetime in logic ticks (60 per second, fixed step, Q42): update() counts ticksLeft down,&lt;br&gt;isExpired() once it reaches 0. A sword swing of 0.2 s = 12 ticks.&lt;br&gt;Moving: the carrier calls moveTo() each tick (arrow after it moves, Character during a swing);&lt;br&gt;shape is replaced by a new Aabb, alreadyHit and ticksLeft are kept.&lt;br&gt;Owner is an Entity: Characters and Traps. Hitbox only answers canHit(); the owner applies&lt;br&gt;the damage (Player: Attack chain, item UML; enemies and traps: damage formula, 1.6).&lt;br&gt;Traps own a Hitbox and damage anyone. An Arrow calls remove() on its first hit (one target)." style="shape=note;size=14;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=10;spacingTop=4;fontSize=11;" vertex="1" parent="1"><mxGeometry x="2660" y="960" width="580" height="160" as="geometry"/></mxCell><mxCell id="e274" value="" style="endArrow=none;dashed=1;html=1;rounded=0;" edge="1" parent="1" source="n_hit" target="Hitbox"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n_enemy" value="Families fix how an enemy attacks: MeleeEnemy = contact hitbox; RangedEnemy =&lt;br&gt;Factory Method createProjectile() (Arrow, Fireball + burn, PoisonZone); SummonerEnemy =&lt;br&gt;EnemyFactory with summoned = true (no loot, Q16); Boss = phases (State, Q53 TBD).&lt;br&gt;Rat, Zombie, Orc, RatNest, Necromancer: data only (data/enemies.json); the Rat Nest is&lt;br&gt;static because its speed is 0. EnemyFactory applies floorMultiplier(floor) at spawn (1.6)." style="shape=note;size=14;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=10;spacingTop=4;fontSize=11;" vertex="1" parent="1"><mxGeometry x="3100" y="1230" width="560" height="100" as="geometry"/></mxCell><mxCell id="e275" value="" style="endArrow=none;dashed=1;html=1;rounded=0;" edge="1" parent="1" source="n_enemy" target="EnemyFactory"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n_player" value="Knight, Mage, Archer differ by stats (JSON, Q15) and&lt;br&gt;starting weapon (Factory Method). Proposal: if they never&lt;br&gt;get their own behaviour, one Player class + a class id in&lt;br&gt;JSON is simpler." style="shape=note;size=14;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=10;spacingTop=4;fontSize=11;" vertex="1" parent="1"><mxGeometry x="642" y="1420" width="330" height="80" as="geometry"/></mxCell><mxCell id="e276" value="" style="endArrow=none;dashed=1;html=1;rounded=0;" edge="1" parent="1" source="n_player" target="Player"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n_legend" value="How to read it&lt;br&gt;solid line + hollow triangle = extends · dashed + hollow triangle = implements&lt;br&gt;filled diamond = owns · open arrow = refers to · dashed arrow = «creates» / «uses»&lt;br&gt;italic = abstract · dashed box = class from another package or page&lt;br&gt;Page 2, Events: EventBus (Observer); Door implements EventListener (RoomCleared).&lt;br&gt;&lt;br&gt;Types from other packages: CharacterBuild, Inventory, Item, LootTable, BurnSpec,&lt;br&gt;ItemFactory, Weapon (item UML); World, HitResult; StateBuffer (rewind feature);&lt;br&gt;RandomSource (seeded, Q114); Vector2, JsonValue (libGDX); StateMachine, State (gdx-ai)." style="shape=note;size=14;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=10;spacingTop=4;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="1906" width="560" height="160" as="geometry"/></mxCell><mxCell id="DamageFormula" value="«utility»&lt;br&gt;&lt;b&gt;DamageFormula&lt;/b&gt;" style="swimlane;fontStyle=0;align=center;verticalAlign=top;childLayout=stackLayout;horizontal=1;startSize=40;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=1;marginBottom=0;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="690" y="1010" width="390" height="64" as="geometry"/></mxCell><mxCell id="DamageFormula_m0" value="&lt;u&gt;+ compute(attack: int, bonus: int, buff: double, resistance: int): int&lt;/u&gt;" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;whiteSpace=wrap;html=1;" vertex="1" parent="DamageFormula"><mxGeometry y="40" width="390" height="24" as="geometry"/></mxCell><mxCell id="e_dmg_uses" value="«uses»" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=open;endSize=10;dashed=1;exitX=0;exitY=0.8;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="Character" target="DamageFormula"><mxGeometry relative="1" as="geometry"><mxPoint x="0" y="-12" as="offset"/></mxGeometry></mxCell><mxCell id="n_damage" value="Damage formula (1.6, Q26): damage = max(1, floor((attack + bonus) x buff / resistance)).&lt;br&gt;Throws if resistance &amp;lt; 1 or buff is negative or not finite. Static, no state.&lt;br&gt;Enemies call it with bonus = 0 and buff = 1; the Player's Weapon.hit()&lt;br&gt;(item UML) calls it with the weapon bonus and the passive-item buff." style="shape=note;size=14;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=10;spacingTop=4;fontSize=11;" vertex="1" parent="1"><mxGeometry x="690" y="1090" width="390" height="84" as="geometry"/></mxCell><mxCell id="e_dmg_note" value="" style="endArrow=none;dashed=1;html=1;rounded=0;" edge="1" parent="1" source="n_damage" target="DamageFormula"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="TriggerBox" value="&lt;b&gt;TriggerBox&lt;/b&gt;" style="swimlane;fontStyle=0;align=center;verticalAlign=top;childLayout=stackLayout;horizontal=1;startSize=26;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=1;marginBottom=0;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="3290" y="950" width="430" height="242" as="geometry"/></mxCell><mxCell id="TriggerBox_a0" value="- oneShot: boolean" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;whiteSpace=wrap;html=1;" vertex="1" parent="TriggerBox"><mxGeometry y="26" width="430" height="24" as="geometry"/></mxCell><mxCell id="TriggerBox_a1" value="- enemiesCanTrigger: boolean" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;whiteSpace=wrap;html=1;" vertex="1" parent="TriggerBox"><mxGeometry y="50" width="430" height="24" as="geometry"/></mxCell><mxCell id="TriggerBox_a2" value="- triggered: boolean" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;whiteSpace=wrap;html=1;" vertex="1" parent="TriggerBox"><mxGeometry y="74" width="430" height="24" as="geometry"/></mxCell><mxCell id="TriggerBox_a3" value="- action: TriggerAction" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;whiteSpace=wrap;html=1;" vertex="1" parent="TriggerBox"><mxGeometry y="98" width="430" height="24" as="geometry"/></mxCell><mxCell id="TriggerBox_d" value="" style="line;strokeWidth=1;fillColor=none;align=left;verticalAlign=middle;spacingTop=-1;spacingLeft=3;spacingRight=3;rotatable=0;labelPosition=right;points=[];portConstraint=eastwest;strokeColor=inherit;" vertex="1" parent="TriggerBox"><mxGeometry y="122" width="430" height="8" as="geometry"/></mxCell><mxCell id="TriggerBox_m0" value="+ TriggerBox(bodyBox: Aabb, oneShot: boolean, enemiesCanTrigger: boolean, action: TriggerAction)" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;whiteSpace=wrap;html=1;" vertex="1" parent="TriggerBox"><mxGeometry y="130" width="430" height="40" as="geometry"/></mxCell><mxCell id="TriggerBox_m1" value="+ onContact(other: Entity): void" style="text;strokeColor=none;fill