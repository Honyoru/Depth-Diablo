nalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endSize=14;endFill=0;dashed=1;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="ItemPickedUp" target="GameEvent"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e305" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endSize=14;endFill=0;dashed=1;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="RoomCleared" target="GameEvent"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e306" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endSize=14;endFill=0;dashed=1;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="Door" target="EventListener"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e307" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endSize=14;endFill=0;dashed=1;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="EventLaser" target="EventListener"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e308" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;startArrow=diamondThin;startFill=1;startSize=16;endArrow=open;endSize=10;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.1591;entryDx=0;entryDy=0;" edge="1" parent="1" source="World" target="EventBus"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="el309" value="1" style="edgeLabel;resizable=0;html=1;align=center;verticalAlign=middle;fontSize=11;" connectable="0" vertex="1" parent="e308"><mxGeometry x="0.85" relative="1" as="geometry"><mxPoint x="0" y="-10" as="offset"/></mxGeometry></mxCell><mxCell id="e310" value="«publishes»" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=open;endSize=10;dashed=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.6515;entryDx=0;entryDy=0;" edge="1" parent="1" source="Character" target="EventBus"><mxGeometry relative="1" as="geometry"><mxPoint x="0" y="-12" as="offset"/></mxGeometry></mxCell><mxCell id="n_flow" value="Pattern: Observer (Q104: the roles are interfaces first). No singleton: World creates&lt;br&gt;the bus and passes it to every emitter and listener (Q103).&lt;br&gt;publish() only queues. World calls flush() once per tick, after every update(): each&lt;br&gt;queued event reaches the listeners of its type, then the subscribeAll() listeners.&lt;br&gt;An event published during flush() waits for the next tick, so a handler cannot loop.&lt;br&gt;Rewind (R) calls clear(): queued events from an undone tick are dropped." style="shape=note;size=14;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=10;spacingTop=4;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1570" y="100" width="560" height="96" as="geometry"/></mxCell><mxCell id="n_events" value="GameEvent is sealed and every event is a record (Q97), so a switch over events is&lt;br&gt;checked by the compiler. source() is the emitter: F2 draws a line from it to each&lt;br&gt;listener that is an entity (GDD 1.1.2). The emitter never holds the receiver.&lt;br&gt;Emitters: Character (DamageDealt, EntityDied), Player (ItemPickedUp), room logic&lt;br&gt;(RoomCleared, the last enemy of a sealed room). Door unseals on RoomCleared (Q13).&lt;br&gt;The event list is still open (Q24): these four are the first ones." style="shape=note;size=14;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=10;spacingTop=4;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1570" y="230" width="560" height="96" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="arena-uml" name="Arena"><mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="1169" pageHeight="827" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title3" value="Arena: UML class diagram (Arena mode, GDD 1.6 waves) · 6 Nov 2026" style="text;html=1;fontSize=18;fontStyle=1;align=left;verticalAlign=middle;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1300" height="36" as="geometry"/></mxCell><mxCell id="ArenaCycle" value="&lt;b&gt;ArenaCycle&lt;/b&gt;" style="swimlane;fontStyle=0;align=center;verticalAlign=top;childLayout=stackLayout;horizontal=1;startSize=40;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=1;marginBottom=0;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="420" y="100" width="340" height="384" as="geometry"/></mxCell><mxCell id="ArenaCycle_a0" value="- wavesPerCycle: int" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;whiteSpace=wrap;html=1;" vertex="1" parent="ArenaCycle"><mxGeometry y="40" width="340" height="24" as="geometry"/></mxCell><mxCell id="ArenaCycle_a1" value="- breakTicks: int" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;whiteSpace=wrap;html=1;" vertex="1" parent="ArenaCycle"><mxGeometry y="64" width="340" height="24" as="geometry"/></mxCell><mxCell id="ArenaCycle_a2" value="- wave: int" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;whiteSpace=wrap;html=1;" vertex="1" parent="ArenaCycle"><mxGeometry y="88" width="340" height="24" as="geomet