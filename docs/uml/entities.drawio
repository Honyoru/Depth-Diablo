ntryDx=0;entryDy=0;" edge="1" parent="1" source="Character" target="CharacterBuild"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="el260" value="1" style="edgeLabel;resizable=0;html=1;align=center;verticalAlign=middle;fontSize=11;" connectable="0" vertex="1" parent="e259"><mxGeometry x="0.85" relative="1" as="geometry"><mxPoint x="0" y="-10" as="offset"/></mxGeometry></mxCell><mxCell id="e261" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;startArrow=diamondThin;startFill=1;startSize=16;endArrow=open;endSize=10;exitX=1;exitY=0.0857;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="Player" target="Inventory"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="el262" value="1" style="edgeLabel;resizable=0;html=1;align=center;verticalAlign=middle;fontSize=11;" connectable="0" vertex="1" parent="e261"><mxGeometry x="0.85" relative="1" as="geometry"><mxPoint x="0" y="-10" as="offset"/></mxGeometry></mxCell><mxCell id="e263" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=open;endSize=10;exitX=1;exitY=0.249;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="Player" target="PlayerInput"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="el264" value="1" style="edgeLabel;resizable=0;html=1;align=center;verticalAlign=middle;fontSize=11;" connectable="0" vertex="1" parent="e263"><mxGeometry x="0.85" relative="1" as="geometry"><mxPoint x="0" y="-10" as="offset"/></mxGeometry></mxCell><mxCell id="e265" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=open;endSize=10;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="ItemPickup" target="Item"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="el266" value="1" style="edgeLabel;resizable=0;html=1;align=center;verticalAlign=middle;fontSize=11;" connectable="0" vertex="1" parent="e265"><mxGeometry x="0.85" relative="1" as="geometry"><mxPoint x="0" y="-10" as="offset"/></mxGeometry></mxCell><mxCell id="e267" value="«uses»" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=open;endSize=10;dashed=1;exitX=0;exitY=0.24;exitDx=0;exitDy=0;entryX=1;entryY=0.2586;entryDx=0;entryDy=0;" edge="1" parent="1" source="Enemy" target="EnemyState"><mxGeometry relative="1" as="geometry"><mxPoint x="0" y="-12" as="offset"/></mxGeometry></mxCell><mxCell id="e268" value="«creates»" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=open;endSize=10;dashed=1;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.212;entryDx=0;entryDy=0;" edge="1" parent="1" source="EnemyFactory" target="Enemy"><mxGeometry relative="1" as="geometry"><mxPoint x="0" y="-12" as="offset"/></mxGeometry></mxCell><mxCell id="e269" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=open;endSize=10;exitX=0.85;exitY=0;exitDx=0;exitDy=0;entryX=0.4792;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="SummonerEnemy" target="EnemyFactory"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e270" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;startArrow=diamondThin;startFill=1;startSize=16;endArrow=open;endSize=10;exitX=1;exitY=0.2597;exitDx=0;exitDy=0;entryX=0;entryY=0.3571;entryDx=0;entryDy=0;" edge="1" parent="1" source="Boss" target="BossPhase"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="el271" value="1..*" style="edgeLabel;resizable=0;html=1;align=center;verticalAlign=middle;fontSize=11;" connectable="0" vertex="1" parent="e270"><mxGeometry x="0.85" relative="1" as="geometry"><mxPoint x="0" y="-10" as="offset"/></mxGeometry></mxCell><mxCell id="n_entity" value="update() is final (Template Method): it calls onUpdate(), the hook each&lt;br&gt;subclass fills. Character.onUpdate(): statuses and i-frames -&amp;gt; think() -&amp;gt; move.&lt;br&gt;Player.think() reads PlayerInput; Enemy.think() runs its gdx-ai state machine.&lt;br&gt;Rewind (R, Memento): every tick each entity writes its own state into a&lt;br&gt;primitive-array StateBuffer (ring buffer, 5 s x 60 ticks, Q86)." style="shape=note;size=14;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=10;spacingTop=4;fontSize=11;" vertex="1" parent="1"><mxGeometry x="2080" y="100" width="470" height="100" as="geometry"/></mxCell><mxCell id="e272" value="" style="endArrow=none;dashed=1;html=1;rounded=0;" edge="1" parent="1" source="n_entity" target="Entity"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n_world" value="Pickable (team): ItemPickup needs the pickup key (2.4); coins and keys go to counters&lt;br&gt;on the Player when touched (proposal). Interactable (proposal): what the interact key&lt;br&gt;opens: chest, door, shop. Door: KEY_LOCKED opens with a key (Q80); SEALED = arena room&lt;br&gt;locked until every enemy inside is dead (Q13). Wall (team): static, blocks movement;&lt;br&gt;proposal: walls can stay tiles of the floor's collision layer, unless the editor (TAB)&lt;br&gt;must move them. The Shopkeeper is never Damageable (1.3.1)." style="shape=note;size=14;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=10;spacingTop=4;fontSize=11;" vertex="1" parent="1"><mxGeometry x="2590" y="100" width="560" height="112" as="geometry"/></mxCell><mxCell id="n_hit" value="Combat (1.5): a Hitbox hits a Damageable hurtbox it overlaps, never its owner&lt;br&gt;and never twice. Then owner.hit(target): the Player goes through its Attack chain&lt;br&gt;(weapon + passive items, item UML); enemies use the damage formula directly (1.6).&lt;br&gt;Projectiles own a Hitbox; melee swings and contact attacks create one." style="shape=note;size=14;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=10;spacingTop=4;fontSize=11;" vertex="1" parent="1"><mxGeometry x="2660" y="960" width="500" height="86" as="geometry"/></mxCell><mxCell id="e273" value="" style="endArrow=none;dashed=1;html=1;rounded=0;" edge="1" parent="1" source="n_hit" target="Hitbox"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n_enemy" value="Families fix how an enemy attacks: MeleeEnemy = contact hitbox; RangedEnemy =&lt;br&gt;Factory Method createProjectile() (Arrow, Fireball + burn, PoisonZone); SummonerEnemy =&lt;br&gt;EnemyFactory with summoned = true (no loot, Q16); Boss = phases (State, Q53 TBD).&lt;br&gt;Rat, Zombie, Orc, RatNest, Necromancer: data only (data/enemies.json); the Rat Nest is&lt;br&gt;static because its speed is 0. EnemyFactory applies floorMultiplier(floor) at spawn (1.6)." style="shape=note;size=14;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=10;spacingTop=4;fontSize=11;" vertex="1" parent="1"><mxGeometry x="3100" y="1230" width="560" height="100" as="geometry"/></mxCell><mxCell id="e274" value="" style="endArrow=none;dashed=1;html=1;rounded=0;" edge="1" parent="1" source="n_enemy" target="EnemyFactory"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n_player" value="Knight, Mage, Archer differ by stats (JSON, Q15) and&lt;br&gt;starting weapon (Factory Method). Proposal: if they never&lt;br&gt;get their own behaviour, one Player class + a class id in&lt;br&gt;JSON is simpler." style="shape=note;size=14;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=10;spacingTop=4;fontSize=11;" vertex="1" parent="1"><mxGeometry x="642" y="1420" width="330" height="80" as="geometry"/></mxCell><mxCell id="e275" value="" style="endArrow=none;dashed=1;html=1;rounded=0;" edge="1" parent="1" source="n_player" target="Player"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n_legend" value="How to read it&lt;br&gt;solid line + hollow triangle = extends · dashed + hollow triangle = implements&lt;br&gt;filled diamond = owns · open arrow = refers to · dashed arrow = «creates» / «uses»&lt;br&gt;italic = abstract · dashed box = class from another package&lt;br&gt;&lt;br&gt;Types from other packages: CharacterBuild, Inventory, Item, LootTable, BurnSpec,&lt;br&gt;ItemFactory, Weapon (item UML); World, HitResult; StateBuffer (rewind feature);&lt;br&gt;RandomSource (seeded, Q114); Vector2, JsonValue (libGDX); StateMachine, State (gdx-ai)." style="shape=note;size=14;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=10;spacingTop=4;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="1906" width="520" height="140" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
