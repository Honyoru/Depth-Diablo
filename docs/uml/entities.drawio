ry relative="1" as="geometry"><mxPoint x="0" y="-12" as="offset"/></mxGeometry></mxCell><mxCell id="GoToNextFloor" value="&lt;b&gt;GoToNextFloor&lt;/b&gt;" style="swimlane;fontStyle=0;align=center;verticalAlign=top;childLayout=stackLayout;horizontal=1;startSize=26;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=1;marginBottom=0;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="4120" y="1110" width="170" height="82" as="geometry"/></mxCell><mxCell id="GoToNextFloor_a0" value="- world: World" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;whiteSpace=wrap;html=1;" vertex="1" parent="GoToNextFloor"><mxGeometry y="26" width="170" height="24" as="geometry"/></mxCell><mxCell id="GoToNextFloor_d" value="" style="line;strokeWidth=1;fillColor=none;align=left;verticalAlign=middle;spacingTop=-1;spacingLeft=3;spacingRight=3;rotatable=0;labelPosition=right;points=[];portConstraint=eastwest;strokeColor=inherit;" vertex="1" parent="GoToNextFloor"><mxGeometry y="50" width="170" height="8" as="geometry"/></mxCell><mxCell id="GoToNextFloor_m0" value="+ execute(who: Entity): void" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;whiteSpace=wrap;html=1;" vertex="1" parent="GoToNextFloor"><mxGeometry y="58" width="170" height="24" as="geometry"/></mxCell><mxCell id="e_GoToNextFloor_impl" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endSize=14;endFill=0;dashed=1;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="GoToNextFloor" target="TriggerAction"><mxGeometry relative="1" as="geometry"><mxPoint x="0" y="-12" as="offset"/></mxGeometry></mxCell><mxCell id="ArmTrap" value="&lt;b&gt;ArmTrap&lt;/b&gt;" style="swimlane;fontStyle=0;align=center;verticalAlign=top;childLayout=stackLayout;horizontal=1;startSize=26;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=1;marginBottom=0;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="4310" y="1110" width="170" height="82" as="geometry"/></mxCell><mxCell id="ArmTrap_a0" value="- trap: Trap" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;whiteSpace=wrap;html=1;" vertex="1" parent="ArmTrap"><mxGeometry y="26" width="170" height="24" as="geometry"/></mxCell><mxCell id="ArmTrap_d" value="" style="line;strokeWidth=1;fillColor=none;align=left;verticalAlign=middle;spacingTop=-1;spacingLeft=3;spacingRight=3;rotatable=0;labelPosition=right;points=[];portConstraint=eastwest;strokeColor=inherit;" vertex="1" parent="ArmTrap"><mxGeometry y="50" width="170" height="8" as="geometry"/></mxCell><mxCell id="ArmTrap_m0" value="+ execute(who: Entity): void" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;whiteSpace=wrap;html=1;" vertex="1" parent="ArmTrap"><mxGeometry y="58" width="170" height="24" as="geometry"/></mxCell><mxCell id="e_ArmTrap_impl" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endSize=14;endFill=0;dashed=1;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="ArmTrap" target="TriggerAction"><mxGeometry relative="1" as="geometry"><mxPoint x="0" y="-12" as="offset"/></mxGeometry></mxCell><mxCell id="e_trigger_action" value="action" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;startArrow=diamondThin;startFill=1;startSize=16;endArrow=open;endSize=10;exitX=1;exitY=0.372;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="TriggerBox" target="TriggerAction"><mxGeometry relative="1" as="geometry"><mxPoint x="0" y="-12" as="offset"/></mxGeometry></mxCell><mxCell id="n_trigger" value="Pattern: Command (Q102). TriggerBox (Q11, Q13, Q36): blocks() returns false and it deals no&lt;br&gt;damage; its zone is Entity.bodyBox. When an entity enters, it calls action.execute(who).&lt;br&gt;Only the Player triggers it, unless enemiesCanTrigger = true.&lt;br&gt;oneShot = true: fires once (room lock, teleport). false: fires on each new entry (trap).&lt;br&gt;A new use = a new TriggerAction class; TriggerBox stays unchanged (open/closed).&lt;br&gt;SealDoors: an arena room seals its doors when the player enters (Door.seal()).&lt;br&gt;GoToNextFloor: TriggerBox (oneShot, Player only) spawned when the boss dies; no TeleportZone class.&lt;br&gt;ArmTrap: entry starts the trap's delayTicks, then the spikes strike with their Hitbox." style="shape=note;size=14;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=10;spacingTop=4;fontSize=11;" vertex="1" parent="1"><mxGeometry x="3930" y="1230" width="560" height="130" as="geometry"/></mxCell><mxCell id="e_trigger_note" value="" style="endArrow=none;dashed=1;html=1;rounded=0;" edge="1" parent="1" source="n_trigger" target="TriggerBox"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell></root></mxGraphModel></diagram><diagram id="events-uml" name="Events"><mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="1169" pageHeight="827" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title2" value="Events: UML class diagram (GDD 1.1.2 F2, Q24, Q103, Q104) · 5 Nov 2026" style="text;html=1;fontSize=18;fontStyle=1;align=left;verticalAlign=middle;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1300" height="36" as="geometry"/></mxCell><mxCell id="EventBus" value="«Observer: subject»&lt;br&gt;&lt;b&gt;EventBus&lt;/b&gt;" style="swimlane;fontStyle=0;align=center;verticalAlign=top;childLayout=stackLayout;horizontal=1;startSize=40;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=1;marginBottom=0;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="420" y="100" width="507" height="264" as="geometry"/></mxCell><mxCell id="EventBus_a277" value="- listeners: Map&amp;lt;Class&amp;lt;? extends GameEvent&amp;gt;, List&amp;lt;EventListener&amp;gt;&amp;gt;" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;whiteSpace=wrap;html=1;" vertex="1" parent="EventBus"><mxGeometry y="40" width="507" height="24" as="geometry"/></mxCell><mxCell id="EventBus_a278" value="- everyEvent: List&amp;lt;EventListener&amp;gt;" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;whiteSpace=wrap;html=1;" vertex="1" parent="EventBus"><mxGeometry y="64" width="507" height="24" as="geometry"/></mxCell><mxCell id="EventBus_a279" value="- queue: Queue&amp;lt;GameEvent&amp;gt;" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;whiteSpace=wrap;html=1;" vertex="1" parent="EventBus"><mxGeometry y="88" width="507" height="24" as="geometry"/></mxCell><mxCell id="EventBus_d280" value="" style="line;strokeWidth=1;fillColor=none;align=left;verticalAlign=middle;spacingTop=-1;spacingLeft=3;spacingRight=3;rotatable=0;labelPosition=right;points=[];portConstraint=eastwest;strokeColor=inherit;" vertex="1" parent="EventBus"><mxGeometry y="112" width="507" height="8" as="geometry"/></mxCell><mx