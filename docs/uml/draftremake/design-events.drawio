<mxfile host="app.diagrams.net" agent="tools/uml/generate_uml.py"><diagram id="design-events" name="Design, events: the 9 Nov draft completed with the code"><mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="Design, events: the 9 Nov draft completed with the code" style="text;html=1;fontSize=18;fontStyle=1;align=left;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="1400" height="30" as="geometry"/></mxCell><mxCell id="legend" value="Generated by tools/uml/generate_uml.py from the first draft (docs/uml/drafts) and the compiled classes. A box tagged «planned» is still a design, as the draft wrote it; every other box is drawn from the code. Hollow arrow: extends (dashed: implements); blue open arrow: a field of that type or a link from the draft." style="text;html=1;fontSize=11;fontColor=#666666;align=left;" vertex="1" parent="1"><mxGeometry x="40" y="42" width="1600" height="20" as="geometry"/></mxCell><mxCell id="c0" value="&lt;div style='line-height:15px'&gt;&lt;div style='text-align:center'&gt;&lt;b&gt;GameConstants&lt;/b&gt;&lt;/div&gt;&lt;div style='border-top:1px solid #333333;margin:3px -6px'&gt;&lt;/div&gt;&lt;u&gt;+ TICKS_PER_SECOND: int&lt;/u&gt;&lt;br&gt;&lt;u&gt;+ VIRTUAL_WIDTH: int&lt;/u&gt;&lt;br&gt;&lt;u&gt;+ VIRTUAL_HEIGHT: int&lt;/u&gt;&lt;br&gt;&lt;u&gt;+ TILE_SIZE: int&lt;/u&gt;&lt;br&gt;&lt;u&gt;+ ENEMY_DETECTION_RANGE: float&lt;/u&gt;&lt;div style='border-top:1px solid #333333;margin:3px -6px'&gt;&lt;/div&gt;- GameConstants()&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fontFamily=Courier New;fontSize=11;fillColor=#ffffff;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="202" y="116" width="246" height="131" as="geometry"/></mxCell><mxCell id="c11" value="&lt;div style='line-height:15px'&gt;&