value="&lt;div style='line-height:15px'&gt;&lt;div style='text-align:center'&gt;«interface»&lt;br&gt;&lt;b&gt;&lt;i&gt;EventListener&lt;/i&gt;&lt;/b&gt;&lt;/div&gt;&lt;div style='border-top:1px solid #333333;margin:3px -6px'&gt;&lt;/div&gt;&amp;nbsp;&lt;div style='border-top:1px solid #333333;margin:3px -6px'&gt;&lt;/div&gt;&lt;i&gt;+ onEvent(GameEvent): void&lt;/i&gt;&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fontFamily=Courier New;fontSize=11;fillColor=#ffffff;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="646" y="627" width="217" height="86" as="geometry"/></mxCell><mxCell id="c7" value="&lt;div style='line-height:15px'&gt;&lt;div style='text-align:center'&gt;&lt;b&gt;FixedTimestep&lt;/b&gt;&lt;/div&gt;&lt;div style='border-top:1px solid #333333;margin:3px -6px'&gt;&lt;/div&gt;&lt;u&gt;+ MAX_TICKS_PER_FRAME: int&lt;/u&gt;&lt;br&gt;&lt;u&gt;- TICK_SECONDS: double&lt;/u&gt;&lt;br&gt;- accumulator: double&lt;div style='border-top:1px solid #333333;margin:3px -6px'&gt;&lt;/div&gt;+ FixedTimestep()&lt;br&gt;+ getAlpha(): float&lt;br&gt;+ advance(double): int&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fontFamily=Courier New;fontSize=11;fillColor=#ffffff;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="947" y="627" width="217" height="131" as="geometry"/></mxCell><mxCell id="c8" value="&lt;div style='line-height:15px'&gt;&lt;div style='text-align:center'&gt;«interface»&lt;br&gt;&lt;b&gt;&lt;i&gt;GameEvent&lt;/i&gt;&lt;/b&gt;&lt;/div&gt;&lt;div style='border-top:1px solid #333333;margin:3px -6px'&gt;&lt;/div&gt;&amp;nbsp;&lt;div style='border-top:1px solid #333333;margin:3px -6px'&gt;&lt;/div&gt;&lt;i&gt;+ source(): Entity&lt;/i&gt;&lt;br&gt;+ receiver(): Optional&amp;lt;Entity&amp;gt;&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fontFamily=Courier New;fontSize=11;fillColor=#ffffff;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="1376" y="627" width="246" height="101" as="geometry"/></mxCell><mxCell id="c14" value="&lt;div style='line-height:15px'&gt;&lt;div style='text-align:center'&gt;&lt;b&gt;World&lt;/b&gt;&lt;/div&gt;&lt;div style='border-top:1px solid #333333;margin:3px -6px'&gt;&lt;/div&gt;- eventBus: EventBus&lt;br&gt;- entities: List&amp;lt;Entity&amp;gt;&lt;br&gt;- entitiesToAdd: List&amp;lt;Entity&amp;gt;&lt;br&gt;- tick: long&lt;br&gt;- ticking: boolean&lt;div style='border-top:1px solid #333333;margin:3px -6px'&gt;&lt;/div&gt;+ World()&lt;br&gt;+ getEventBus(): EventBus&lt;br&gt;+ getEntities(): List&amp;lt;Entity&amp;gt;&lt;br&gt;+ getCurrentTick(): long&lt;br&gt;+ add(Entity): void&lt;br&gt;+ tick(): void&lt;br&gt;+ isFree(Aabb, Entity): boolean&lt;br&gt;+ isFree(Obb, Entity): boolean&lt;br&gt;- resolveContacts(): void&lt;br&gt;&lt;u&gt;- touch(Entity, Entity): boolean&lt;/u&gt;&lt;br&gt;+ writeState(StateBuffer): void&lt;br&gt;+ readState(StateBuffer): void&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fontFamily=Courier New;fontSize=11;fillColor=#ffffff;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="195" y="903" width="260" height="296" as="geometry"/></mxCell><mxCell id="c1" value="&lt;div style='line-height:15px'&gt;&lt;div style='text-align:center'&gt;&lt;b&gt;EventLaser&lt;/b&gt;&lt;/div&gt;&lt;div style='border-top:1px solid #333333;margin:3px -6px'&gt;&lt;/div&gt;&lt;u&gt;+ LINE_LIFETIME_TICKS: int&lt;/u&gt;&lt;br&gt;- lines: List&amp;lt;EventLaser.Line&amp;gt;&lt;br&gt;- enabled: boolean&lt;div style='border-top:1px solid #333333;margin:3px -6px'&gt;&lt;/div&gt;+ EventLaser()&lt;br&gt;+ getName(): String&lt;br&gt;+ getLines(): List&amp;lt;EventLaser.Line&amp;gt;&lt;br&gt;+ enable(): void&lt;br&gt;+ disable(): void&lt;br&gt;+ isEnabled(): boolean&lt;br&gt;+ onTick(long): void&lt;br&gt;+ onEvent(GameEvent): void