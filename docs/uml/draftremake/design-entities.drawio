<mxfile host="app.diagrams.net" agent="tools/uml/generate_uml.py"><diagram id="design-entities" name="Design, entities: the 5-9 Nov draft completed with the code"><mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="Design, entities: the 5-9 Nov draft completed with the code" style="text;html=1;fontSize=18;fontStyle=1;align=left;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="1400" height="30" as="geometry"/></mxCell><mxCell id="legend" value="Generated by tools/uml/generate_uml.py from the first draft (docs/uml/drafts) and the compiled classes. A box tagged «planned» is still a design, as the draft wrote it; every other box is drawn from the code. Hollow arrow: extends (dashed: implements); blue open arrow: a field of that type or a link from the draft." style="text;html=1;fontSize=11;fontColor=#666666;align=left;" vertex="1" parent="1"><mxGeometry x="40" y="42" width="1600" height="20" as="geometry"/></mxCell><mxCell id="c1" value="&lt;div style='line-height:15px'&gt;&lt;div style='text-align:center'&gt;&lt;b&gt;DamageFormula&lt;/b&gt;&lt;/div&gt;&lt;div style='border-top:1px solid #333333;margin:3px -6px'&gt;&lt;/div&gt;&amp;nbsp;&lt;div style='border-top:1px solid #333333;margin:3px -6px'&gt;&lt;/div&gt;- DamageFormula()&lt;br&gt;&lt;u&gt;+ compute(int, int, double, int, int, double): int&lt;/u&gt;&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fontFamily=Courier New;fontSize=11;fillColor=#ffffff;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="172" y="116" width="390" height="86" as="geometry"/></mxCell><mxCell id="c11" value="&lt;div style='line-height:15px'&gt;&lt;div style='text-align:center'&gt;«interface»&lt;br&gt;&lt;b&gt;&lt;i&gt;BuildModifier&lt;/i&gt;&lt;/b&gt;&lt;/div&gt;&lt;div style='border-top:1px solid #333333;margin:3px -6px'&gt;&lt;/div&gt;&amp;nbsp;&lt;div style='border-top:1px solid #333333;margin:3px -6px'&gt;&lt;/div&gt;&lt;i&gt;+ modify(CharacterBuild): CharacterBuild&lt;/i&gt;&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fontFamily=Courier New;fontSize=11;fillColor=#ffffff;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="926" y="116" width="318" height="86" as="geometry"/></mxCell><mxCell id="c13" value="&lt;div style='line-height:15px'&gt;&lt;div style='text-align:center'&gt;«record»&lt;br&gt;&lt;b&gt;CharacterBuild&lt;/b&gt;&lt;/div&gt;&lt;div style='border-top:1px solid #333333;margin:3px -6px'&gt;&lt;/div&gt;- attack: Attack&lt;br&gt;- stats: StatSource&lt;div style='border-top:1px solid #333333;margin:3px -6px'&gt;&lt;/div&gt;+ withAttack(Attack): CharacterBuild&lt;br&gt;+ withStats(StatSource): CharacterBuild&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fontFamily=Courier New;fontSize=11;fillColor=#ffffff;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="1702" y="116" width="311" height="116" as="geometry"/></mxCell><mxCell id="c14" value="&lt;div style='line-height:15px'&gt;&lt;div style='text-align:center'&gt;«interface»&lt;br&gt;&lt;b&gt;&lt;i&gt;Collidable&lt;/i&gt;&lt;/b&gt;&lt;/div&gt;&lt;div style='border-top:1px solid #333333;margin:3px -6px'&gt;&lt;/div&gt;&amp;nbsp;&lt;div style='border-top:1px solid #333333;margin:3px -6px'&gt;&lt;/div&gt;&lt;i&gt;+ getBodyBox(): Aabb&lt;/i&gt;&lt;br&gt;&lt;i&gt;+ blocks(): boolean&lt;/i&gt;&lt;br&gt;&lt;i&gt;+ onContact(Entity): void&lt;/i&gt;&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fontFamily=Courier New;fontSize=11;fillColor=#ffffff;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="2522" y="116" width="210" height="116" as="geometry"/></mxCell><mxCell id="c16" value="&lt;di