y"><Array as="points"><mxPoint x="2562.5" y="70" /><mxPoint x="1092.5" y="70" /></Array><mxPoint x="0" y="-10" as="offset" /></mxGeometry></mxCell><mxCell id="el200" value="0..20" style="edgeLabel;resizable=0;html=1;align=center;verticalAlign=middle;fontSize=11;" connectable="0" vertex="1" parent="e199"><mxGeometry x="0.93" relative="1" as="geometry"><mxPoint x="0" y="-10" as="offset" /></mxGeometry></mxCell><mxCell id="e201" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;startArrow=diamondThin;startFill=1;startSize=16;endArrow=open;endSize=10;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.443;entryDx=0;entryDy=0;" edge="1" parent="1" source="Player" target="Inventory"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="el202" value="1" style="edgeLabel;resizable=0;html=1;align=center;verticalAlign=middle;fontSize=11;" connectable="0" vertex="1" parent="e201"><mxGeometry x="0.7" relative="1" as="geometry"><mxPoint x="0" y="-10" as="offset" /></mxGeometry></mxCell><mxCell id="e203" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endSize=14;endFill=0;exitX=0.3;exitY=0;exitDx=0;exitDy=0;entryX=0.4313;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="Player" target="Character"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e204" value="build" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=open;endSize=10;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="Character" target="CharacterBuild"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="3376.5" y="122.0" /></Array></mxGeometry></mxCell><mxCell id="el205" value="1" style="edgeLabel;resizable=0;html=1;align=center;verticalAlign=middle;fontSize=11;" connectable="0" vertex="1" parent="e204"><mxGeometry x="0.95" relative="1" as="geometry"><mxPoint x="0" y="-10" as="offset" /></mxGeometry></mxCell><mxCell id="n_factory" value="DataRegistry parses data/items.json (Q129). ItemSpecReader&lt;br&gt;reads each entry into an ItemSpec chosen by its &quot;class&quot;,&lt;br&gt;e.g. &quot;class&quot;: &quot;FireRing&quot;; ItemFactory builds the item from it.&lt;br&gt;F5 re-reads the file; live items are re-created by id (1.1.2)." style="shape=note;size=14;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=10;spacingTop=4;fontSize=11;" vertex="1" parent="1"><mxGeometry x="400" y="100" width="330" height="72" as="geometry" /></mxCell><mxCell id="e206" value="" style="endArrow=none;dashed=1;html=1;rounded=0;" edge="1" parent="1" source="n_factory" target="ItemFactory"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="n_weapon" value="Weapon = the attack Strategy. modify() makes it the&lt;br&gt;build's Attack and adds attackSpeed to ATTACK_SPEED,&lt;br&gt;so passive items can change it; the Player tracks&lt;br&gt;the cooldown. hit() applies the damage formula (1.6)." style="shape=note;size=14;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=10;spacingTop=4;fontSize=11;" vertex="1" parent="1"><mxGeometry x="460" y="700" width="340" height="86" as="geometry" /></mxCell><mxCell id="e207" value="" style="endArrow=none;dashed=1;html=1;rounded=0;" edge="1" parent="1" source="n_weapon" target="Weapon"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="n_inventory" value="Slots 0-2 = hotbar, consumables only. Slots 3-19: any item.&lt;br&gt;No stacking. add() returns false when no free slot accepts&lt;br&gt;the item: it stays on the ground. equip() moves a weapon or&lt;br&gt;armor to the portrait; the old one takes its slot.&lt;br&gt;drop() is a proposal, so a full inventory can free a slot.&lt;br&gt;RouletteTicket.use() returns false: the roulette spends it." style="shape=note;size=14;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=10;spacingTop=4;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1990" y="100" width="380" height="120" as="geometry" /></mxCell><mxCell id="e208" value="" style="endArrow=none;dashed=1;html=1;rounded=0;" edge="1" parent="1" source="n_inventory" target="Inventory"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="n_build" value="After every inventory change the character rebuilds its build:&lt;br&gt;base build (class stats from JSON, Unarmed attack)&lt;br&gt;-&amp;gt; weapon -&amp;gt; armor -&amp;gt; passive items in pickup order.&lt;br&gt;Removing an item = rebuilding without it, so stats come&lt;br&gt;back exactly (1.4.1). Hitboxes and projectiles call&lt;br&gt;owner.hit(target); the Player sends it through its Attack&lt;br&gt;chain, so passive effects also apply to arrows and fireballs." style="shape=note;size=14;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=10;spacingTop=4;fontSize=11;" vertex="1" parent="1"><mxGeometry x="3200" y="1180" width="360" height="132" as="geometry" /></mxCell><mxCell id="e209" value="" style="endArrow=none;dashed=1;html=1;rounded=0;" edge="1" parent="1" source="n_build" target="CharacterBuild"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="n_passives" value="Example passive items: names and values are proposals; values live in data/items.json.&lt;br&gt;A passive item overrides decorateStats() and/or decorateAttack(); its final modify() applies both to the build,&lt;br&gt;e.g. FireRing.decorateAttack(inner) returns new FireTouch(inner, burn). SwiftBoots and HeavyGauntlet also add a StatBonus&lt;br&gt;(speed, attack speed). StatPassive covers every pure stat item from JSON alone. Two copies stack by their StackMode (ADD or MULTIPLY).&lt;br&gt;FireTouch.hit(): inner.hit(attacker, target), then, if the hit landed, target.applyStatus(new Burn(burn, attacker))." style="shape=note;size=14;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=10;spacingTop=4;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1760" y="1432" width="860" height="100" as="geometry" /></mxCell><mxCell id="n_legend" value="How to read it&lt;br&gt;solid line + hollow triangle = extends · dashed + hollow triangle = implements&lt;br&gt;hollow diamond = holds · filled diamond = owns · dashed arrow = «creates»&lt;br&gt;italic = abstract · dashed box = class from another package&lt;br&gt;&lt;br&gt;Types from other packages: Character, Player, World, HitResult,&lt;br&gt;Aabb (collision box, 1.5), Hitbox, Arrow, Fireball, ItemPickup,&lt;br&gt;RandomSource (seeded, Q114), Vector2 and JsonValue (libGDX).&lt;br&gt;Coins and keys are pickups, not Items: they go to counters&lt;br&gt;on the Player (keys: proposal). Rarity values: proposal." style="shape=note;size=14;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=10;spacingTop=4;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="1250" width="440" height="172" as="geometry" /></mxCell><mxCell id="ItemSpecReader" value="&lt;b&gt;ItemSpecReader&lt;/b&gt;" style="swimlane;fontStyle=0;align=center;verticalAlign=top;childLayout=stackLayout;horizontal=1;startSize=26;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=1;marginBottom=0;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="740" y="180" width="250" height="50" as="geometry" /></mxCell><mxCell id="ItemSpecReader_um0" value="+ read(id: String, entry: JsonValue): ItemSpec" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;whiteSpace=wrap;html=1;fontStyle=4;" vertex="1" parent="ItemSpecReader"><mxGeometry y="26" width="250" height="24" as="geometry" /></mxCell><mxCell id="ItemSpec" value="«interface»&lt;br&gt;&lt;b&gt;ItemSpec&lt;/b&gt; {sealed}" style="swimlane;fontStyle=0;align=center;verticalAlign=top;childLayout=stackLayout;horizontal=1;startSize=40;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=1;marginBottom=0;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="760" y="300" width="210" height="136" as="geometry" /></mxCell><mxCell id="ItemSpec_um0" value="+ id(): String" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;whiteSpace=wrap;html=1;" vertex="1" parent="ItemSpec"><mxGeometry y="40" width="210" height="24" as="geometry" /></mxCell><mxCell id="ItemSpec_um1" value="+ nameKey(): String" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;whiteSpace=wrap;html=1;" vertex="1" parent="ItemSpec"><mxGeometry y="64" width="210" height="24" as="geometry" /></mxCell><mxCell id="ItemSpec_um2" value="+ spriteId(): String" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;whiteSpace=wrap;html=1;" vertex="1" parent="ItemSpec"><mxGeometry y="88" width="210" height="24" as="geometry" /></mxCell><mxCell id="ItemSpec_um3" value="+ price(): int" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;whiteSpace=wrap;html=1;" vertex="1" parent="ItemSpec"><mxGeometry y="112" width="210" height="24" as="geometry" /></mxCell><mxCell id="PotionSpec" value="«record»&lt;br&gt;&lt;b&gt;PotionSpec&lt;/b&gt;" style="swimlane;fontStyle=0;align=center;verticalAlign=top;childLayout=stackLayout;horizontal=1;startSize=40;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=1;marginBottom=0;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="420" y="320" width="280" height="88" as="geometry" /></mxCell><mxCell id="PotionSpec_ua0" value="id, nameKey, spriteId, price" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;whiteSpace=wrap;html=1;" vertex="1" parent="PotionSpec"><mxGeometry y="40" width="280" height="24" as="geometry" /></mxCell><mxCell id="PotionSpec_ua1" value="healAmount: int" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;whiteSpace=wrap;html=1;" vertex="1" parent="PotionSpec"><mxGeometry y="64" width="280" height="24" as="geometry" /></mxCell><mxCell id="FireRingSpec" value="«record»&lt;br&gt;&lt;b&gt;FireRingSpec&lt;/b&gt;" style="swimlane;fontStyle=0;align=center;verticalAlign=top;childLayout=stackLayout;horizontal=1;startSize=40;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=1;marginBottom=0;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="420" y="420" width="280" height="88" as="geometry" /></mxCell><mxCell id="FireRingSpec_ua0" value="id, nameKey, spriteId, price" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;whiteSpace=wrap;html=1;" vertex="1" parent="FireRingSpec"><mxGeometry y="40" width="280" height="24" as="geometry" /></mxCell><mxCell id="FireRingSpec_ua1" value="burn: BurnSpec" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;whiteSpace=wrap;html=1;" vertex="1" parent="FireRingSpec"><mxGeometry y="64" width="280" height="24" as="geometry" /></mxCell><mxCell id="SwordSpec" value="«record»&lt;br&gt;&lt;b&gt;SwordSpec&lt;/b&gt;" style="swimlane;fontStyle=0;align=center;verticalAlign=top;childLayout=stackLayout;horizontal=1;startSize=40;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=1;marginBottom=0;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="460" y="560" width="280" height="136" as="geometry" /></mxCell><mxCell id="SwordSpec_ua0" value="id, nameKey, spriteId, price" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;whiteSpace=wrap;html=1;" vertex="1" parent="SwordSpec"><mxGeometry y="40" width="280" height="24" as="geometry" /></mxCell><mxCell id="SwordSpec_ua1" value="rarity: Rarity, attackBonus: int" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;whiteSpace=wrap;html=1;" vertex="1" parent="SwordSpec"><mxGeometry y="64" width="280" height="24" as="geometry" /></mxCell><mxCell id="SwordSpec_ua2" value="attackSpeed, range, width, arcDegrees: float" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;whiteSpace=wrap;html=1;" vertex="1" parent="SwordSpec"><mxGeometry y="88" width="280" height="24" as="geometry" /></mxCell><mxCell id="SwordSpec_ua3" value="swingTicks: int" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;whiteSpace=wrap;html=1;" vertex="1" parent="SwordSpec"><mxGeometry y="112" width="280" height="24" as="geometry" /></mxCell><mxCell id="e_factory_reader" value="«uses»" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=open;endSize=10;dashed=1;" edge="1" parent="1" source="ItemFactory" target="ItemSpecReader"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e_reader_spec" value="«creates»" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=open;endSize=10;dashed=1;" edge="1" parent="1" source="ItemSpecReader" target="ItemSpec"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e_PotionSpec_impl" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endSize=14;endFill=0;dashed=1;" edge="1" parent="1" source="PotionSpec" target="ItemSpec"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e_FireRingSpec_impl" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endSize=14;endFill=0;dashed=1;" edge="1" parent="1" source="FireRingSpec" target="ItemSpec"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e_SwordSpec_impl" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endSize=14;endFill=0;dashed=1;" edge="1" parent="1" source="SwordSpec" target="ItemSpec"><mxGeometry relative="1" as="geometry" /></mxCell></root></mxGraphModel></diagram></mxfile>