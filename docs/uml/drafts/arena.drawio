exitX=1;exitY=0.25;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="ArenaCycle" target="Phase"><mxGeometry relative="1" as="geometry"><mxPoint x="0" y="-12" as="offset"/></mxGeometry></mxCell><mxCell id="A_World" value="&lt;b&gt;World&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;engine · Arena mode, one per run&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;dashed=1;dashPattern=6 4;" vertex="1" parent="1"><mxGeometry x="40" y="120" width="200" height="44" as="geometry"/></mxCell><mxCell id="e_world_cycle" value="1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=open;endSize=10;startArrow=diamondThin;startFill=1;startSize=16;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.1;entryDx=0;entryDy=0;" edge="1" parent="1" source="A_World" target="ArenaCycle"><mxGeometry relative="1" as="geometry"><mxPoint x="0" y="-12" as="offset"/></mxGeometry></mxCell><mxCell id="A_Shop" value="&lt;b&gt;Shopkeeper&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;entity · page Entities&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;dashed=1;dashPattern=6 4;" vertex="1" parent="1"><mxGeometry x="40" y="300" width="200" height="44" as="geometry"/></mxCell><mxCell id="e_shop" value="«uses» getPhase() == SHOP" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=open;endSize=10;dashed=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.6;entryDx=0;entryDy=0;" edge="1" parent="1" source="A_Shop" target="ArenaCycle"><mxGeometry relative="1" as="geometry"><mxPoint x="0" y="-12" as="offset"/></mxGeometry></mxCell><mxCell id="st_title" value="&lt;b&gt;Phase transitions&lt;/b&gt;" style="text;html=1;align=left;fontSize=13;" vertex="1" parent="1"><mxGeometry x="40" y="550" width="300" height="24" as="geometry"/></mxCell><mxCell id="st_init" value="" style="ellipse;html=1;fillColor=strokeColor;" vertex="1" parent="1"><mxGeometry x="90" y="688" width="24" height="24" as="geometry"/></mxCell><mxCell id="st_wave" value="WAVE" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="420" y="670" width="140" height="60" as="geometry"/></mxCell><mxCell id="st_break" value="BREAK" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="880" y="560" width="140" height="60" as="geometry"/></mxCell><mxCell id="st_shop" value="SHOP" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="880" y="780" width="140" height="60" as="geometry"/></mxCell><mxCell id="t_start" value="new ArenaCycle()&lt;br&gt;wave = 1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=classic;endSize=10;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="st_init" target="st_wave"><mxGeometry relative="1" as="geometry"><mxPoint x="0" y="-12" as="offset"/></mxGeometry></mxCell><mxCell id="t_w_b" value="waveCleared() [normal wave]&lt;br&gt;/ score + 1, timer = breakTicks" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=classic;endSize=10;exitX=0.5;exitY=0;entryX=0;entryY=0.5;" edge="1" parent="1" source="st_wave" target="st_break"><mxGeometry relative="1" as="geometry"><mxPoint x="0" y="-12" as="offset"/></mxGeometry></mxCell><mxCell id="t_b_w" value="update(): timer reaches 0&lt;br&gt;/ wave + 1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=classic;endSize=10;exitX=0.5;exitY=1;entryX=1;entryY=0.25;" edge="1" parent="1" source="st_break" target="st_wave"><mxGeometry relative="1" as="geometry"><mxPoint x="0" y="12" as="offset"/></mxGeometry></mxCell><mxCell id="t_w_s" value="waveCleared() [boss wave]&lt;br&gt;/ score + 1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=classic;endSize=10;exitX=0.5;exitY=1;entryX=0;entryY=0.5;" edge="1" parent="1" source="st_wave" target="st_shop"><mxGeometry relative="1" as="geometry"><mxPoint x="0" y="-12" as="offset"/></mxGeometry></mxCell><mxCell id="t_s_w" value="startNextCycle()&lt;br&gt;/ wave + 1, returns true" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=classic;endSize=10;exitX=0.5;exitY=0;entryX=1;entryY=0.75;" edge="1" parent="1" source="st_shop" target="st_wave"><mxGeometry relative="1" as="geometry"><mxPoint x="0" y="12" as="offset"/></mxGeometry></mxCell><mxCell id="n_cycle" value="Arena mode (DECISIONS): waves in cycles of wavesPerCycle = 5. Waves 1-4 are normal,&lt;br&gt;wave 5 is the boss. isBossWave() = wave % wavesPerCycle == 0, so 10, 15... are bosses too.&lt;br&gt;15 s break between normal waves: breakTicks = 15 x GameConstants.TICKS_PER_SECOND.&lt;br&gt;After a boss wave the shopkeeper opens; the next cycle starts only when the player&lt;br&gt;activates it (startNextCycle()). Score = waves defeated = number of waveCleared() calls." style="shape=note;size=14;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=10;spacingTop=4;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1100" y="100" width="560" height="96" as="geometry"/></mxCell><mxCell id="n_rules" value="Guards: the constructor throws if wavesPerCycle &amp;lt; 1 or breakTicks &amp;lt; 1.&lt;br&gt;waveCleared() outside WAVE throws IllegalStateException (no wave to clear).&lt;br&gt;startNextCycle() outside SHOP does nothing and returns false.&lt;br&gt;update() only counts down during BREAK; WAVE and SHOP ignore it.&lt;br&gt;Deterministic: no clock, no randomness, ticks only (core rules, Q114)." style="shape=note;size=14;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=10;spacingTop=4;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1100" y="230" width="560" height="96" as="geometry"/></mxCell><mxCell id="n_open" value="Open (proposal): who calls waveCleared(): the arena room logic when the last enemy&lt;br&gt;of the wave dies, the same rule that publishes RoomCleared (page Events).&lt;br&gt;Which enemies spawn per wave is still TBD (DECISIONS, open questions);&lt;br&gt;the spawner reads getWaveNumber() and isBossWave() and stays out of ArenaCycle." style="shape=note;size=14;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=10;spacingTop=4;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1100" y="360" width="560" height="84" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
