<mxfile host="app.diagrams.net" agent="tools/uml/generate_uml.py"><diagram id="01-engine" name="Engine: world, fixed step, events, rewind photo"><mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="Engine: world, fixed step, events, rewind photo" style="text;html=1;fontSize=18;fontStyle=1;align=left;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="1400" height="30" as="geometry"/></mxCell><mxCell id="legend" value="Generated by tools/uml/generate_uml.py from the compiled classes. Hollow arrow: extends (dashed: implements). Blue open arrow: a field of that type, named on the arrow. Grey dashed boxes are drawn in another diagram." style="text;html=1;fontSize=11;fontColor=#666666;align=left;" vertex="1" parent="1"><mxGeometry x="40" y="42" width="1600" height="20" as="geometry"/></mxCell><mxCell id="c1" value="&lt;div style='text-align:center'&gt;&lt;b&gt;EventBus&lt;/b&gt;&lt;/div&gt;&lt;hr size='1'&gt;- listeners: Map&amp;lt;Class&amp;lt;? extends GameEvent&amp;gt;, List&amp;lt;EventListener&amp;gt;&amp;gt;&lt;br&gt;- everyEvent: List&amp;lt;EventListener&amp;gt;&lt;br&gt;- queue: Queue&amp;lt;GameEvent&amp;gt;&lt;hr size='1'&gt;+ EventBus()&lt;br&gt;+ subscribe(Class&amp;lt;? extends GameEvent&amp;gt;, EventListener): void&lt;br&gt;+ subscribeAll(EventListener): void&lt;br&gt;+ unsubscribe(EventListener): void&lt;br&gt;+ publish(GameEvent): void&lt;br&gt;+ flush(): void&lt;br&gt;+ clear(): void&lt;br&gt;&lt;u&gt;- deliver(GameEvent, List&amp;lt;EventListener&amp;gt;): void&lt;/u&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fontFamily=Courier New;fontSize=11;fillColor=#ffffff;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="76" y="126" width="285" height="217" as="geometry"/></mxCell><mxCell id="c10" value="&lt;div style