<mxfile host="app.diagrams.net" agent="tools/uml/generate_uml.py"><diagram id="12-desktop-audio" name="Desktop: sound effects and music"><mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="Desktop: sound effects and music" style="text;html=1;fontSize=18;fontStyle=1;align=left;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="1400" height="30" as="geometry"/></mxCell><mxCell id="legend" value="Generated by tools/uml/generate_uml.py from the compiled classes. Hollow arrow: extends (dashed: implements). Blue open arrow: the class has a field of that type (see its box). Grey dashed boxes are drawn in another diagram." style="text;html=1;fontSize=11;fontColor=#666666;align=left;" vertex="1" parent="1"><mxGeometry x="40" y="42" width="1600" height="20" as="geometry"/></mxCell><mxCell id="c0" value="&lt;div style='line-height:15px'&gt;&lt;div style='text-align:center'&gt;&lt;b&gt;GameAudio&lt;/b&gt;&lt;/div&gt;&lt;div style='border-top:1px solid #333333;margin:3px -6px'&gt;&lt;/div&gt;&lt;u&gt;~ EFFECTS_VOLUME: float&lt;/u&gt;&lt;br&gt;- sounds: Map&amp;lt;SoundEffect, Sound&amp;gt;&lt;br&gt;- music: MusicPlayer&lt;br&gt;- overlapGuard: SoundOverlapGuard&lt;div style='border-top:1px solid #333333;margin:3px -6px'&gt;&lt;/div&gt;+ GameAudio()&lt;br&gt;+ play(SoundEffect, Object): void&lt;br&gt;+ playMusic(MusicTrack): void&lt;br&gt;+ updateMusic(float): void&lt;br&gt;&lt;u&gt;~ volumeOf(SoundEffect): float&lt;/u&gt;&lt;br&gt;+ dispose(): void&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fontFamily=Courier New;fontSize=11;fillColor=#ffffff;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="134" y="150" width="268" height="191" as="geometry"/></mxCell><mxCell id="c1" value="&lt;div style='line-height:15px'&gt;&lt;div style=