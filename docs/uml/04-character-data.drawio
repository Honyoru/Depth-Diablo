<mxfile host="app.diagrams.net" agent="tools/uml/generate_uml.py"><diagram id="04-character-data" name="Character data: characters.json to characters"><mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="Character data: characters.json to characters" style="text;html=1;fontSize=18;fontStyle=1;align=left;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="1400" height="30" as="geometry"/></mxCell><mxCell id="legend" value="Generated by tools/uml/generate_uml.py from the compiled classes. Hollow arrow: extends (dashed: implements). Blue open arrow: the class has a field of that type (see its box). Grey dashed boxes are drawn in another diagram." style="text;html=1;fontSize=11;fontColor=#666666;align=left;" vertex="1" parent="1"><mxGeometry x="40" y="42" width="1600" height="20" as="geometry"/></mxCell><mxCell id="c1" value="&lt;div style='line-height:15px'&gt;&lt;div style='text-align:center'&gt;«interface»&lt;br&gt;&lt;b&gt;&lt;i&gt;CharacterKind&lt;/i&gt;&lt;/b&gt;&lt;/div&gt;&lt;div style='border-top:1px solid #333333;margin:3px -6px'&gt;&lt;/div&gt;&amp;nbsp;&lt;div style='border-top:1px solid #333333;margin:3px -6px'&gt;&lt;/div&gt;&lt;i&gt;+ name(): String&lt;/i&gt;&lt;br&gt;&lt;u&gt;+ of(String): CharacterKind&lt;/u&gt;&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fontFamily=Courier New;fontSize=11;fillColor=#ffffff;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="267" y="116" width="224" height="101" as="geometry"/></mxCell><mxCell id="c10" value="&lt;div style='line-height:15px'&gt;&lt;div style='text-align:center'&gt;«interface»&lt;br&gt;&lt;b&gt;&lt;i&gt;Reloadable&lt;/i&gt;&lt;/b&gt;&lt;/div&gt;&lt;div style='border-top:1px solid #333333;margin:3px -6px'&gt;&lt;/div&gt;&amp;nbsp;&lt;div style='border-top: